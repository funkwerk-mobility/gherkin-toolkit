{
  "name": "gherkin-toolkit",
  "version": "0.1.0",
  "description": "Tools for checking Gherkin feature files",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "cuke": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && vitest run",
    "lint": "oxlint --vitest-plugin --deny-warnings src test vitest.config.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "@cspell/dict-de-de": "^4.1.4",
    "@cspell/dict-en_us": "^4.4.43",
    "@cspell/dict-en-gb": "^5.0.38",
    "@cspell/dict-fr-fr": "^2.3.2",
    "@cspell/dict-nb-no": "^3.0.0",
    "@cucumber/gherkin": "^43.0.0",
    "@cucumber/messages": "^35.0.0",
    "cspell-lib": "^10.5.2",
    "dictionary-lb": "^4.0.0",
    "nspell": "^2.1.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/nspell": "^2.1.6",
    "oxlint": "^1.95.0",
    "typescript": "^5.0.0",
    "vitest": "^5.1.2"
  }
}
